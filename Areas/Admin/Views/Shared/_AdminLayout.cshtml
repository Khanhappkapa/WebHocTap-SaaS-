@* ============================================================
    File: Areas/Admin/Views/Shared/_AdminLayout.cshtml
    Mô tả: Layout cho khu vực Admin — sidebar trái + content phải
    CHECKPOINT: @inject UserManager — hiển thị FullName thật + form POST logout
============================================================ *@
@using Microsoft.AspNetCore.Identity
@using WebHocTap_SaaS_.Models
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bulb.edu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header class="sticky-top admin-header-sticky">
        <nav class="navbar navbar-dark admin-topbar px-2 px-sm-3">
            <div class="d-flex align-items-center gap-2">
                <button class="navbar-toggler d-lg-none p-1 px-2" type="button"
                        data-bs-toggle="collapse" data-bs-target="#adminMobileNav"
                        aria-controls="adminMobileNav" aria-expanded="false" aria-label="Mở menu điều hướng"
                        style="border: 1.5px solid #ffffff; border-radius: var(--cm-radius); box-shadow: 1.5px 1.5px 0 #ffffff;">
                    <span class="navbar-toggler-icon" style="width: 1.25em; height: 1.25em;"></span>
                </button>
                <a class="navbar-brand mb-0 d-flex align-items-center me-0" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-shield-lock me-1 text-danger"></i>
                    <span class="fw-bold" style="font-family: var(--cm-font-hand); font-size: 1.45rem;">Admin Panel</span>
                </a>
            </div>

            <div class="d-flex align-items-center gap-2 ms-auto">
                @* CHECKPOINT: Hiển thị FullName thật + badge role *@
                <span class="text-light fw-bold d-none d-sm-inline-flex align-items-center text-truncate" style="max-width: 130px;" title="@currentUser?.FullName">
                    <i class="bi bi-person-circle me-1"></i> @currentUser?.FullName
                </span>
                
                <span class="sketch-role-badge role-admin">
                    <i class="bi bi-shield-fill-check" aria-hidden="true"></i>
                    <span>Admin</span>
                </span>

                @* CHECKPOINT: Logout BẮT BUỘC form POST — chống CSRF *@
                <form asp-controller="Account" asp-action="Logout" method="post" asp-area="" class="m-0 p-0">
                    <button type="submit" class="btn-sketch-logout" aria-label="Đăng xuất">
                        <i class="bi bi-box-arrow-right text-danger" aria-hidden="true"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </nav>

        <!-- Dropdown Menu từ trên xuống cho Mobile Admin -->
        <div class="collapse d-lg-none admin-mobile-dropdown" id="adminMobileNav">
            <div class="p-2 p-sm-3">
                <ul class="nav flex-column gap-1">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <span class="link-icon-box"><i class="bi bi-speedometer2"></i></span>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "User" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-people-fill"></i></span>
                            <span>Người dùng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Course" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-journal-code"></i></span>
                            <span>Khóa học</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Report" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-graph-up"></i></span>
                            <span>Thống kê</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="app-layout-body d-flex">
        @* Sidebar cho Desktop *@
        <nav class="sidebar admin-sidebar d-none d-lg-flex flex-column" id="adminSidebarDesktop">
            <div class="sidebar-header p-3 pb-2">
                <div class="sidebar-title-badge">
                    <i class="bi bi-shield-lock-fill text-danger" aria-hidden="true"></i>
                    <span>Quản Trị</span>
                </div>
            </div>
            <div class="sidebar-menu-wrapper px-2 flex-grow-1">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <span class="link-icon-box"><i class="bi bi-speedometer2"></i></span>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "User" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-people-fill"></i></span>
                            <span>Người dùng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Course" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-journal-code"></i></span>
                            <span>Khóa học</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link @(currentCtrl == "Report" ? "active" : "")" href="#">
                            <span class="link-icon-box"><i class="bi bi-graph-up"></i></span>
                            <span>Thống kê</span>
                        </a>
                    </li>
                </ul>
            </div>

            @* Mini Sketch Sticky Note Widget ở đáy Sidebar Admin *@
            <div class="sidebar-footer-widget p-3 mt-auto">
                <div class="sketch-sidebar-note">
                    <div class="sketch-note-pin" aria-hidden="true"></div>
                    <div class="sketch-note-title">
                        <i class="bi bi-shield-shaded text-danger me-1"></i> Quản trị viên
                    </div>
                    <p class="sketch-note-text mb-0">
                        Hệ thống hoạt động ổn định &amp; an toàn.
                    </p>
                </div>
            </div>
        </nav>

        <main class="main-content flex-grow-1 p-3 p-md-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_SketchSymbols")
</body>
</html>
