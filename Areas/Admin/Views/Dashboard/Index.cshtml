@* ============================================================
    File: Areas/Admin/Views/Dashboard/Index.cshtml
    Mô tả: Trang Dashboard Admin — dữ liệu thật từ ViewBag
============================================================ *@
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 fw-bold"><i class="bi bi-speedometer2" aria-hidden="true"></i> Admin Dashboard</h1>

    <div class="row g-4">
        <div class="col-lg-3 col-md-6">
            <div class="card card-stat border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                    <h5 class="mt-2">Người dùng</h5>
                    <p class="stat-number">@ViewBag.UserCount</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card card-stat border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="stat-icon text-success"><i class="bi bi-journal-code"></i></div>
                    <h5 class="mt-2">Khóa học</h5>
                    <p class="stat-number">@ViewBag.CourseCount</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card card-stat border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="stat-icon" style="color: var(--cm-accent)"><i class="bi bi-pencil-square"></i></div>
                    <h5 class="mt-2">Bài tập</h5>
                    <p class="stat-number">@ViewBag.AssignmentCount</p>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card card-stat border-0 shadow-sm">
                <div class="card-body text-center">
                    <div class="stat-icon text-info"><i class="bi bi-file-earmark-text"></i></div>
                    <h5 class="mt-2">Bài nộp</h5>
                    <p class="stat-number">@ViewBag.SubmissionCount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <h5 class="card-title">Chào mừng đến Admin Panel</h5>
            <p class="text-muted">
                Đây là trang quản trị hệ thống Bulb.edu.
                Bạn có thể quản lý người dùng, khóa học, xem thống kê từ sidebar bên trái.
            </p>
        </div>
    </div>
</div>
