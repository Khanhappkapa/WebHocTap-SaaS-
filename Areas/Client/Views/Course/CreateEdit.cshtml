@model WebHocTap_SaaS_.Models.ViewModels.CourseViewModel
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa khóa học" : "Tạo khóa học mới";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 mt-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
                    <h4 class="mb-0">@(isEdit ? "<i class=\"bi bi-pencil-square\"></i> Chỉnh sửa khóa học" : "<i class=\"bi bi-plus-circle\"></i> Tạo khóa học mới")</h4>
                    <a asp-action="Manage" class="btn btn-light btn-sm">Quay lại danh sách</a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                        }
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Chèn form chung -->
                        <partial name="_CourseFormPartial" model="Model" />
                        
                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-primary px-4">
                                @(isEdit ? "<i class=\"bi bi-save\"></i> Lưu thay đổi" : "<i class=\"bi bi-plus-circle\"></i> Tạo khóa học")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
