@model WebHocTap_SaaS_.Models.ViewModels.CourseViewModel
@{
    bool isEdit = Model.Id > 0;
}

<div class="container pb-5">
    <div class="row pt-4 justify-content-center">
        <div class="col-md-9 col-lg-7">
            
            <a asp-action="Manage" class="breadcrumb-back d-inline-flex align-items-center mb-3 text-decoration-none fw-bold" style="color: var(--cm-primary); border-bottom: 2px solid transparent;">
                <i class="bi bi-arrow-left me-2"></i> Quay lại danh sách
            </a>

            <div class="form-page form-card position-relative p-4 p-md-5" style="border: var(--cm-hand-border); border-radius: var(--cm-hand-radius-md); background: var(--cm-surface); box-shadow: -6px 6px 0 var(--cm-postit);">
                <h1 class="h2 text-center fw-bold mb-2" style="font-family: var(--cm-font-hand); font-size: 2.8rem; transform: rotate(-1.5deg);">
                    @(isEdit ? "Chỉnh sửa khóa học" : "Tạo khóa học mới")
                    <i class="bi bi-rocket-takeoff text-danger ms-2"></i>
                </h1>
                
                <div class="text-center mb-4">
                    <svg viewBox="0 0 260 12" style="width: 140px; height: auto; fill: none; stroke: var(--cm-primary); stroke-width: 2.5; stroke-linecap: round;"><use href="#bulb-detail-wave"></use></svg>
                </div>

                <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="Id" />
                    }
                    
                    <div asp-validation-summary="ModelOnly" class="assignment-validation text-danger mb-3"></div>

                    <!-- Chèn form chung -->
                    <partial name="_CourseFormPartial" model="Model" />
                    
                    <div class="mt-4 pt-4 text-center border-top border-dark" style="border-width: 1.5px !important;">
                        <button type="submit" class="btn btn-cta w-100 fw-bold py-3 fs-5" style="background-color: var(--cm-accent); color: var(--cm-ink); border: var(--cm-hand-border); border-radius: var(--cm-radius); box-shadow: 4px 4px 0 var(--cm-ink);">
                            @(isEdit ? "Lưu thay đổi" : "Tạo khóa học") <i class="bi bi-check-circle-fill ms-2"></i>
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
