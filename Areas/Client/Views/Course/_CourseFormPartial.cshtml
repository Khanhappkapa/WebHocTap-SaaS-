@model WebHocTap_SaaS_.Models.ViewModels.CourseViewModel

<div class="mb-4">
    <label asp-for="Title" class="form-label fw-bold"></label>
    <input asp-for="Title" class="form-control sketch-input" placeholder="Nhập tên khóa học..." />
    <span asp-validation-for="Title" class="error-msg d-block mt-1"></span>
</div>

<div class="mb-4">
    <label asp-for="Status" class="form-label fw-bold"></label>
    <select asp-for="Status" class="form-select form-control sketch-input" style="background-color: var(--cm-paper);">
        <option value="Draft">Bản nháp (Học sinh không thấy)</option>
        <option value="Published">Công khai (Học sinh có thể đăng ký)</option>
        <option value="Closed">Đóng cửa (Không nhận thêm học sinh)</option>
    </select>
    <span asp-validation-for="Status" class="error-msg d-block mt-1"></span>
</div>

<div class="mb-4">
    <label asp-for="Description" class="form-label fw-bold"></label>
    <textarea asp-for="Description" class="form-control sketch-input" rows="5" placeholder="Viết mô tả ngắn gọn về khóa học..."></textarea>
    <span asp-validation-for="Description" class="error-msg d-block mt-1"></span>
</div>
