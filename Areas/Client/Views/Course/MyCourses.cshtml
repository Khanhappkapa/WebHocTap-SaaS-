@model IEnumerable<WebHocTap_SaaS_.Models.ViewModels.CourseCardViewModel>
@{
    ViewData["Title"] = "Khóa học của tôi";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="bi bi-journal-code"></i> Khóa học của tôi</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa đăng ký khóa học nào. <a asp-action="Index">Duyệt khóa học ngay!</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-start border-4 border-success">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-success">@course.Title</h5>
                            <p class="text-muted small mb-2">👨‍🏫 GV: @course.TeacherName</p>
                            <p class="card-text flex-grow-1">@course.Description</p>
                            
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-success mt-auto">Vào lớp học</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
