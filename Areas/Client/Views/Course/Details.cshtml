@model WebHocTap_SaaS_.Models.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model.IsOwner)
{
<main class="course-detail course-detail-owner">
    <section class="detail-banner" aria-labelledby="course-title">
        <div class="detail-banner-inner d-flex flex-wrap
                    align-items-center justify-content-between">
            <div class="detail-banner-copy">
                @if (Model.Course.Status == WebHocTap_SaaS_.Models.CourseStatus.Published)
                {
                    <span class="badge badge-status-published">Đã công khai</span>
                }
                else if (Model.Course.Status == WebHocTap_SaaS_.Models.CourseStatus.Closed)
                {
                    <span class="badge badge-status-closed">Đã đóng</span>
                }
                else
                {
                    <span class="badge badge-status-draft">Bản nháp</span>
                }
                <h1 id="course-title">@Model.Course.Title</h1>
                <p>@(string.IsNullOrEmpty(Model.Course.Description) ? "Chưa có mô tả" : Model.Course.Description)</p>
            </div>

            <div class="detail-banner-actions d-flex align-items-center">
                <svg class="detail-graduate"
                     aria-hidden="true" focusable="false">
                    <use href="#bulb-detail-graduate"></use>
                </svg>

                <a asp-controller="Course" asp-action="Edit" asp-route-id="@Model.Course.Id"
                   class="btn btn-ink" data-action="edit-course">
                    + Sửa khóa học
                </a>
            </div>
        </div>
    </section>

    <div class="detail-content">
        <!-- SECTION A — P5 Sessions -->
        <section id="sessions" class="section-block"
                 aria-labelledby="sessions-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="sessions-title">Buổi học / Lịch học</h2>
                    <svg class="detail-underline"
                         aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>

                <a asp-controller="Session" asp-action="Create" asp-route-courseId="@Model.Course.Id"
                   class="btn btn-cta" data-action="add-session">
                    + Thêm buổi học
                </a>
            </div>

            @if(Model.Sessions.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var s in Model.Sessions)
                    {
                        <li class="detail-row">
                            <i class="bi bi-calendar-event detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                <h3>@s.Title</h3>
                                <p>@s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @s.StartTime.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div class="detail-row-actions">
                                <a asp-controller="Session" asp-action="Edit" asp-route-id="@s.Id" 
                                   class="btn btn-cta-ghost" data-action="edit-session">Sửa</a>
                                <form asp-controller="Session" asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn xóa buổi học này không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-cta-ghost detail-icon-button"
                                            data-action="delete-session"
                                            aria-label="Xóa buổi @s.Title">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art"
                         aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có buổi học nào.</p>
                </div>
            }
        </section>

        <!-- SECTION B — P5 Documents -->
        <section id="materials" class="section-block"
                 aria-labelledby="materials-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="materials-title">Tài liệu</h2>
                    <svg class="detail-underline"
                         aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>
            </div>

            <form class="detail-upload-form"
                  method="post"
                  asp-controller="Material"
                  asp-action="Create"
                  enctype="multipart/form-data"
                  data-action="add-document">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CourseId" value="@Model.Course.Id" />

                <fieldset class="detail-upload-options">
                    <legend class="visually-hidden">Phương thức thêm tài liệu</legend>

                    <input class="visually-hidden" type="radio"
                           id="upload-mode-file"
                           name="FileType" value="Docx" checked />
                    <label class="detail-mode-label" for="upload-mode-file">
                        Tải tệp
                    </label>

                    <input class="visually-hidden" type="radio"
                           id="upload-mode-link"
                           name="FileType" value="Link" />
                    <label class="detail-mode-label" for="upload-mode-link">
                        Liên kết
                    </label>
                </fieldset>

                <div class="upload-zone">
                    <div class="detail-upload-file">
                        <label class="detail-upload-label" for="document-file">
                            <i class="bi bi-paperclip" aria-hidden="true"></i>
                            <span>Kéo thả file vào đây</span>
                        </label>
                        <input id="document-file" class="sketch-input"
                               type="file" name="file"
                               accept=".pdf,.docx,.pptx,.xlsx,.doc" />
                    </div>

                    <div class="detail-upload-link">
                        <div class="detail-form-field">
                            <label for="detail-document-title">Tiêu đề tài liệu</label>
                            <input id="detail-document-title" class="sketch-input" type="text" name="Title" placeholder="Nhập tiêu đề..." required />
                        </div>
                        <div class="detail-form-field">
                            <label for="detail-document-url">Đường dẫn tài liệu</label>
                            <input id="detail-document-url"
                                   class="sketch-input"
                                   type="url"
                                   name="FileUrl"
                                   placeholder="https://..." />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-ink">
                        Thêm tài liệu
                    </button>
                </div>
            </form>

            @if(Model.Materials.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var m in Model.Materials)
                    {
                        <li class="detail-row">
                            <i class="bi @(m.FileType == WebHocTap_SaaS_.Models.FileType.Video ? "bi-camera-video" : (m.FileType == WebHocTap_SaaS_.Models.FileType.Link ? "bi-globe" : "bi-paperclip")) detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                @if (m.FileType == WebHocTap_SaaS_.Models.FileType.Link || m.FileType == WebHocTap_SaaS_.Models.FileType.Video) {
                                    <h3 class="detail-link-text"><a href="@m.FileUrl" target="_blank">@m.Title</a></h3>
                                } else {
                                    <h3><a href="@m.FileUrl" target="_blank">@m.Title</a></h3>
                                }
                            </div>
                            <span class="detail-type-chip">@m.FileType.ToString().ToUpper()</span>
                            
                            <form asp-controller="Material" asp-action="Delete" asp-route-id="@m.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn xóa tài liệu này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-cta-ghost detail-icon-button"
                                        data-action="delete-document"
                                        aria-label="Xóa @m.Title">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có tài liệu nào.</p>
                </div>
            }
        </section>

        <!-- SECTION C — P6 Bài tập (dữ liệu thật) -->
        <section id="assignments" class="section-block"
                 aria-labelledby="assignments-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="assignments-title">Bài tập</h2>
                    <svg class="detail-underline" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>

                <a asp-controller="Assignment" asp-action="Create" asp-route-courseId="@Model.Course.Id"
                   class="btn btn-ink">
                    + Tạo bài tập mới
                </a>
            </div>

            @if(Model.Assignments.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var a in Model.Assignments)
                    {
                        <li class="detail-row">
                            <i class="bi bi-file-earmark-text detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                <h3>@a.Title</h3>
                                <p>Hạn nộp: @a.Deadline.ToString("dd/MM/yyyy, HH:mm")</p>
                            </div>
                            <span class="detail-submission-count">@a.Submissions.Count/@Model.StudentCount đã nộp</span>
                            <a asp-controller="Assignment" asp-action="Details" asp-route-id="@a.Id"
                               class="btn btn-cta-ghost">Chấm bài</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có bài tập nào.</p>
                </div>
            }
        </section>
    </div>
</main>
}
else if (Model.IsEnrolled)
{
<main class="course-detail course-detail-enrolled">
    <section class="detail-banner" aria-labelledby="course-title">
        <div class="detail-banner-inner d-flex flex-wrap
                    align-items-center justify-content-between">
            <div class="detail-banner-copy">
                <h1 id="course-title">@Model.Course.Title</h1>
                <p>@(string.IsNullOrEmpty(Model.Course.Description) ? "Chưa có mô tả" : Model.Course.Description)</p>
            </div>

            <svg class="detail-graduate" aria-hidden="true" focusable="false">
                <use href="#bulb-detail-graduate"></use>
            </svg>
        </div>
    </section>

    <div class="detail-content">
        <section id="sessions" class="section-block"
                 aria-labelledby="sessions-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="sessions-title">Buổi học / Lịch học</h2>
                    <svg class="detail-underline" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>
            </div>

            @if(Model.Sessions.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var s in Model.Sessions)
                    {
                        <li class="detail-row">
                            <i class="bi bi-calendar-event detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                <h3>@s.Title</h3>
                                <p>@s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @s.StartTime.ToString("dd/MM/yyyy")</p>
                            </div>
                            <a href="@s.MeetingUrl" target="_blank" rel="noopener" class="btn btn-cta-ghost is-blue"
                               data-action="join-session">Tham gia</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có buổi học nào.</p>
                </div>
            }
        </section>

        <section id="materials" class="section-block"
                 aria-labelledby="materials-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="materials-title">Tài liệu</h2>
                    <svg class="detail-underline" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>
            </div>

            @if(Model.Materials.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var m in Model.Materials)
                    {
                        <li class="detail-row">
                            <i class="bi @(m.FileType == WebHocTap_SaaS_.Models.FileType.Video ? "bi-camera-video" : (m.FileType == WebHocTap_SaaS_.Models.FileType.Link ? "bi-globe" : "bi-paperclip")) detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                @if (m.FileType == WebHocTap_SaaS_.Models.FileType.Link || m.FileType == WebHocTap_SaaS_.Models.FileType.Video) {
                                    <h3 class="detail-link-text">@m.Title</h3>
                                } else {
                                    <h3>@m.Title</h3>
                                }
                            </div>
                            <span class="detail-type-chip">@m.FileType.ToString().ToUpper()</span>
                            <a href="@m.FileUrl" target="_blank" rel="noopener" class="btn btn-cta-ghost"
                               data-action="access-document">Tải xuống</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có tài liệu nào.</p>
                </div>
            }
        </section>

        <!-- SECTION C — P6 Bài tập (dữ liệu thật, student view) -->
        <section id="assignments" class="section-block"
                 aria-labelledby="assignments-title">
            <div class="detail-section-header">
                <div class="section-title">
                    <h2 id="assignments-title">Bài tập</h2>
                    <svg class="detail-underline" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-wave"></use>
                    </svg>
                </div>
            </div>

            @if(Model.Assignments.Count > 0)
            {
                <ul class="detail-list">
                    @foreach (var a in Model.Assignments)
                    {
                        var mySubmission = a.Submissions.FirstOrDefault(s => s.StudentId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
                        <li class="detail-row">
                            <i class="bi bi-file-earmark-text detail-row-icon" aria-hidden="true"></i>
                            <div class="detail-row-copy">
                                <h3>@a.Title</h3>
                                <p>Hạn nộp: @a.Deadline.ToString("dd/MM/yyyy, HH:mm")</p>
                            </div>
                            @if (mySubmission == null)
                            {
                                <span class="badge badge-state-unsubmitted">Chưa nộp</span>
                            }
                            else if (mySubmission.Score == null)
                            {
                                <span class="badge badge-state-submitted">Đã nộp</span>
                            }
                            else
                            {
                                <span class="badge badge-state-graded">@mySubmission.Score?.ToString("0.##")/@a.MaxScore</span>
                            }
                            <a asp-controller="Assignment" asp-action="Details" asp-route-id="@a.Id"
                               class="btn btn-cta-ghost">Xem bài</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty-state">
                    <svg class="detail-empty-art" aria-hidden="true" focusable="false">
                        <use href="#bulb-detail-empty"></use>
                    </svg>
                    <p>Chưa có bài tập nào.</p>
                </div>
            }
        </section>
    </div>
</main>
}
else
{
<main class="course-detail course-detail-locked">
    @Html.AntiForgeryToken()
    <section class="detail-banner" aria-labelledby="course-title">
        <div class="detail-banner-inner d-flex flex-wrap
                    align-items-center justify-content-between">
            <div class="detail-banner-copy">
                <h1 id="course-title">@Model.Course.Title</h1>
                <p>@(string.IsNullOrEmpty(Model.Course.Description) ? "Chưa có mô tả" : Model.Course.Description)</p>
            </div>

            <div class="detail-banner-actions d-flex align-items-center">
                <svg class="detail-graduate" aria-hidden="true" focusable="false">
                    <use href="#bulb-detail-graduate"></use>
                </svg>
                <button type="button" class="btn btn-cta"
                        data-action="enroll-course" data-id="@Model.Course.Id" id="btnEnroll">
                    Đăng ký khóa học
                </button>
            </div>
        </div>
    </section>

    <div class="detail-content">
        <section id="sessions"
                 class="section-block detail-locked-panel"
                 aria-labelledby="sessions-title">
            <div class="section-title">
                <h2 id="sessions-title">Buổi học</h2>
                <svg class="detail-underline" aria-hidden="true" focusable="false">
                    <use href="#bulb-detail-wave"></use>
                </svg>
            </div>
            <p class="detail-lock-message">
                <i class="bi bi-lock" aria-hidden="true"></i>
                Đăng ký để xem nội dung
            </p>
        </section>

        <section id="materials"
                 class="section-block detail-locked-panel"
                 aria-labelledby="materials-title">
            <div class="section-title">
                <h2 id="materials-title">Tài liệu</h2>
                <svg class="detail-underline" aria-hidden="true" focusable="false">
                    <use href="#bulb-detail-wave"></use>
                </svg>
            </div>
            <p class="detail-lock-message">
                <i class="bi bi-lock" aria-hidden="true"></i>
                Đăng ký để xem nội dung
            </p>
        </section>

        <section id="assignments"
                 class="section-block detail-locked-panel"
                 aria-labelledby="assignments-title">
            <div class="section-title">
                <h2 id="assignments-title">Bài tập</h2>
                <svg class="detail-underline" aria-hidden="true" focusable="false">
                    <use href="#bulb-detail-wave"></use>
                </svg>
            </div>
            <p class="detail-lock-message">
                <i class="bi bi-lock" aria-hidden="true"></i>
                Đăng ký để xem nội dung
            </p>
        </section>
    </div>
</main>
}

@section Scripts {
    <script>
        const enrollButtons = document.querySelectorAll('[data-action="enroll-course"]');
        enrollButtons.forEach(btnEnroll => {
            btnEnroll.addEventListener('click', function () {
                const courseId = this.getAttribute('data-id');
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                btnEnroll.disabled = true;
                btnEnroll.innerHTML = '<i class="bi bi-hourglass-split"></i> Đang xử lý...';

                fetch('/Client/Course/Enroll/' + courseId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload(); 
                    } else {
                        alert('Lỗi: ' + data.message);
                        btnEnroll.disabled = false;
                        btnEnroll.innerHTML = 'Đăng ký khóa học';
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Đã xảy ra lỗi mạng!');
                    btnEnroll.disabled = false;
                    btnEnroll.innerHTML = 'Đăng ký khóa học';
                });
            });
        });
    </script>
}
