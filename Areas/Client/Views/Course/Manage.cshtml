@model IEnumerable<WebHocTap_SaaS_.Models.ViewModels.CourseCardViewModel>
@{
    ViewData["Title"] = "Quản lý khóa học (Teacher)";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear" aria-hidden="true"></i> Quản lý khóa học của tôi</h2>
        <a asp-action="Create" class="btn btn-cta fw-bold"><i class="bi bi-plus-circle" aria-hidden="true"></i> Tạo khóa học mới</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert" style="background: var(--cm-postit); border: var(--cm-hand-border-thin); border-radius: var(--cm-soft-radius);">
            <i class="bi bi-info-circle" aria-hidden="true"></i> Bạn chưa tạo khóa học nào.
        </div>
    }
    else
    {
        <div class="table-responsive p-3" style="background: var(--cm-surface); border: var(--cm-hand-border); border-radius: var(--cm-soft-radius); box-shadow: var(--cm-shadow);">
            <table class="table table-hover align-middle mb-0">
                <thead style="border-bottom: var(--cm-hand-border-thin);">
                    <tr>
                        <th width="35%">Tên khóa học</th>
                        <th width="20%">Trạng thái</th>
                        <th width="15%">Số học viên</th>
                        <th width="15%">Ngày tạo</th>
                        <th width="15%" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @foreach (var course in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--cm-line);">
                            <td>
                                <strong>@course.Title</strong>
                            </td>
                            <td>
                                @if(course.Status == WebHocTap_SaaS_.Models.CourseStatus.Published)
                                {
                                    <span class="badge badge-status-published"><i class="bi bi-globe2 me-1"></i> Công khai</span>
                                }
                                else if(course.Status == WebHocTap_SaaS_.Models.CourseStatus.Closed)
                                {
                                    <span class="badge badge-status-closed"><i class="bi bi-lock-fill me-1"></i> Đã đóng</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-draft"><i class="bi bi-pencil-square me-1"></i> Bản nháp</span>
                                }
                            </td>
                            <td>
                                <span class="badge" style="background: var(--cm-blue-pen); color: white;">@course.StudentCount hv</span>
                            </td>
                            <td>@course.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-cta-ghost btn-sm px-2 py-1 mb-1" title="Chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-cta-ghost btn-sm px-2 py-1 mb-1" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                
                                <form asp-action="Delete" asp-route-id="@course.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này không? Cả bài tập và dữ liệu bên trong sẽ bị xóa theo!');">
                                    <button type="submit" class="btn btn-cta-ghost btn-sm px-2 py-1 mb-1 text-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
