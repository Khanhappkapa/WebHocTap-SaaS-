@* ============================================================
    File: Areas/Client/Views/Shared/_ClientLayout.cshtml
    Mô tả: Layout cho khu vực Client (Teacher + Student)
    CHECKPOINT: Topbar + Sidebar trái (màu xanh dương #0d47a1)
    Responsive: sidebar ẩn thành offcanvas khi < 992px
============================================================ *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClassManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @* --------------------------------------------------
       CHECKPOINT: Topbar Client — hiển thị trên mọi kích thước
       Nút burger chỉ hiển thị khi < 992px (d-lg-none)
    -------------------------------------------------- *@
    <header>
        <nav class="navbar navbar-dark client-topbar px-3">
            <button class="navbar-toggler d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#clientSidebar"
                    aria-controls="clientSidebar" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <span class="navbar-brand mb-0 h1">🎓 ClassManagement</span>
            <div class="d-flex align-items-center">
                <span class="text-light me-3">👤 Người dùng</span>
                <a href="/Account/Logout" class="btn btn-outline-light btn-sm">Đăng xuất</a>
            </div>
        </nav>
    </header>

    <div class="d-flex">
        @* --------------------------------------------------
           CHECKPOINT: Sidebar Client
           Desktop (≥992px): sidebar cố định bên trái, width 250px
           Mobile (<992px): sidebar ẩn, mở bằng offcanvas Bootstrap
           Màu xanh dương (#0d47a1) — phân biệt với Admin (#1a1a2e)
        -------------------------------------------------- *@

        @* Sidebar cho Desktop — ẩn khi < 992px *@
        <nav class="sidebar client-sidebar d-none d-lg-flex flex-column" id="clientSidebarDesktop">
            <div class="sidebar-header p-3">
                <h5 class="text-white mb-0">📖 Menu</h5>
            </div>
            <ul class="nav flex-column px-2">
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Dashboard" asp-action="Index">
                        🏠 Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" href="#">
                        📚 Khóa học của tôi
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" href="#">
                        🔍 Duyệt khóa học
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link" href="#">
                        📝 Bài tập
                    </a>
                </li>
            </ul>
        </nav>

        @* Offcanvas Sidebar cho Mobile — hiển thị khi < 992px *@
        <div class="offcanvas offcanvas-start client-sidebar" tabindex="-1"
             id="clientSidebar" aria-labelledby="clientSidebarLabel"
             style="width: 250px;">
            <div class="offcanvas-header">
                <h5 class="text-white" id="clientSidebarLabel">📖 Menu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
            </div>
            <div class="offcanvas-body p-0">
                <ul class="nav flex-column px-2">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Dashboard" asp-action="Index">
                            🏠 Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" href="#">
                            📚 Khóa học của tôi
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" href="#">
                            🔍 Duyệt khóa học
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" href="#">
                            📝 Bài tập
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        @* --------------------------------------------------
           CHECKPOINT: Vùng nội dung chính
           Desktop: margin-left nhường chỗ cho sidebar (CSS)
           Mobile: margin-left 0 (sidebar ẩn)
        -------------------------------------------------- *@
        <main class="main-content flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
