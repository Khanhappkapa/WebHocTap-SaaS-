@* ============================================================
    File: Areas/Client/Views/Shared/_ClientLayout.cshtml
    Mô tả: Layout cho khu vực Client (Teacher + Student)
    CHECKPOINT: @inject UserManager — hiển thị FullName thật + badge role + form POST logout
============================================================ *@
@using Microsoft.AspNetCore.Identity
@using WebHocTap_SaaS_.Models
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roleBadge = currentUser?.UserRole == "Teacher" ? "bg-success" : "bg-info";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bulb.edu</title>
    <!-- Core Bootstrap & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Design System Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- Bulb.edu Sketch System (CSS rules inside will use local Caveat font) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-dark client-topbar px-3">
            <button class="navbar-toggler d-lg-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#clientSidebar"
                    aria-controls="clientSidebar" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <span class="navbar-brand mb-0 h1"><i class="bi bi-mortarboard-fill"></i> Bulb.edu</span>
            <div class="d-flex align-items-center">
                @* CHECKPOINT: Hiển thị FullName thật + badge role (Teacher=xanh lá, Student=xanh dương) *@
                <span class="text-light me-2"><i class="bi bi-person-circle"></i> @currentUser?.FullName</span>
                <span class="badge @roleBadge me-3">@currentUser?.UserRole</span>
                @* CHECKPOINT: Logout BẮT BUỘC form POST — chống CSRF *@
                <form asp-controller="Account" asp-action="Logout" method="post" asp-area="">
                    <button type="submit" class="btn btn-outline-light btn-sm">Đăng xuất</button>
                </form>
            </div>
        </nav>
    </header>

    <div class="d-flex">
        @* Sidebar cho Desktop *@
        <nav class="sidebar client-sidebar d-none d-lg-flex flex-column" id="clientSidebarDesktop">
            <div class="sidebar-header p-3">
                <h5 class="text-white mb-0"><i class="bi bi-list-ul"></i> Menu</h5>
            </div>
            <ul class="nav flex-column px-2">
                <li class="nav-item">
                    <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-house-door"></i> Dashboard
                    </a>
                </li>
                @if (User.IsInRole("Teacher"))
                {
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="Manage">
                            <i class="bi bi-gear"></i> Quản lý khóa học
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="MyCourses">
                            <i class="bi bi-journal-code"></i> Khóa học của tôi
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="Index">
                            <i class="bi bi-search"></i> Duyệt khóa học
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link sidebar-link" href="#">
                        <i class="bi bi-pencil-square"></i> Bài tập
                    </a>
                </li>
            </ul>
        </nav>

        @* Offcanvas Sidebar cho Mobile *@
        <div class="offcanvas offcanvas-start client-sidebar" tabindex="-1"
             id="clientSidebar" aria-labelledby="clientSidebarLabel"
             style="width: 250px;">
            <div class="offcanvas-header">
                <h5 class="text-white" id="clientSidebarLabel"><i class="bi bi-list-ul"></i> Menu</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
            </div>
            <div class="offcanvas-body p-0">
                <ul class="nav flex-column px-2">
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-house-door"></i> Dashboard
                        </a>
                    </li>
                    @if (User.IsInRole("Teacher"))
                    {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="Manage">
                                <i class="bi bi-gear"></i> Quản lý khóa học
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="MyCourses">
                                <i class="bi bi-journal-code"></i> Khóa học của tôi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-area="Client" asp-controller="Course" asp-action="Index">
                                <i class="bi bi-search"></i> Duyệt khóa học
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link sidebar-link" href="#">
                            <i class="bi bi-pencil-square"></i> Bài tập
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <main class="main-content flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
