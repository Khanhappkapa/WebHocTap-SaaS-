@* ============================================================
    File: Views/Shared/_Layout.cshtml (PUBLIC)
    Mô tả: Layout cho trang công khai
    CHECKPOINT: @inject SignInManager — hiển thị khác nhau khi login/chưa login
    SEO: <html lang="vi">, <meta description>, semantic tags
============================================================ *@
@using Microsoft.AspNetCore.Identity
@using WebHocTap_SaaS_.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClassManagement</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="author" content="ClassManagement Team" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <svg class="detail-svg-definitions"
         xmlns="http://www.w3.org/2000/svg"
         aria-hidden="true"
         focusable="false">
        <defs>
            <!-- Motif người tốt nghiệp: đúng một chi tiết đỏ là tia sét -->
            <symbol id="bulb-detail-graduate" viewBox="0 0 112 96">
                <g transform="translate(-1.5,-8.5)">
                    <path d="M41 56 C44 53 52 53 56 57
                             C60 64 55 70 49 70
                             C42 70 38 63 41 56 Z" />

                    <path d="M47 71 C37 71 37 82 42 88
                             C46 93 53 92 57 86
                             C61 80 61 75 58 72
                             C68 69 75 59 77 51
                             C79 44 78 39 75 38
                             Q72 37 70 40
                             C71 48 72 57 66 64
                             C62 69 56 72 52 72
                             C50 71 48 71 47 71 Z" />

                    <path d="M35 55 L46 45 L61 47 L50 57 Z
                             M41 54 L52 51 L55 58 Q50 61 43 60 Z
                             M38 54 L39 64 M38 64 L40 64" />

                    <path d="M66 35 L73 37 L70 42 Z
                             M71 39 L80 46
                             M46 45 C44 55 56 33 66 35" />

                    <path class="detail-lightning"
                          d="M56 21 L45 34 L56 32
                             L46 45 L49 36 L40 38 Z" />
                </g>
            </symbol>
            <symbol id="bulb-detail-wave" viewBox="0 0 260 12">
                <path d="M3 7 C20 2 35 10 52 5
                         S84 9 103 5 S136 9 154 5
                         S190 9 210 5 S239 9 257 5" />
            </symbol>

            <symbol id="bulb-detail-empty" viewBox="0 0 80 64">
                <path d="M19 23 L40 16 L62 23 L42 31 Z
                         M19 23 L21 49 L42 55 L42 31
                         M62 23 L60 49 L42 55
                         M19 23 L8 16 L29 8 L40 16
                         M40 16 L51 8 L73 16 L62 23
                         M19 23 L9 31 L31 39 L42 31
                         M62 23 L72 31 L52 39 L42 31" />
            </symbol>
        </defs>
    </svg>

    <header class="bulb-header">
        <nav class="navbar navbar-expand-lg bulb-navbar"
             aria-label="Điều hướng chính">
            <div class="container bulb-header-inner">

                <a class="navbar-brand bulb-brand"
                   asp-controller="Home" asp-action="Index"
                   aria-label="Bulb — Trang chủ">

                    <img src="~/asset/images/logo.svg" alt="Bulb Logo" style="height: 38px;" class="me-2" />
                    <span class="bulb-wordmark">Bulb.edu</span>
                </a>

                <button class="navbar-toggler bulb-menu-toggle"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#bulbHeaderMenu"
                        aria-controls="bulbHeaderMenu"
                        aria-expanded="false"
                        aria-label="Mở hoặc đóng menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

                <div class="collapse navbar-collapse bulb-header-menu"
                     id="bulbHeaderMenu">

                    <ul class="navbar-nav bulb-nav-links">
                        <li class="nav-item">
                            <a class="nav-link active"
                               asp-controller="Home" asp-action="Index"
                               aria-current="page">
                                Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/#features">
                                Tính năng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Pricing">
                                Bảng giá
                            </a>
                        </li>
                    </ul>

                    <!-- Authentication Actions -->
                    <div class="bulb-auth-actions d-flex align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var appUser = await UserManager.GetUserAsync(User);
                            string initials = "";
                            if (appUser != null && !string.IsNullOrWhiteSpace(appUser.FullName))
                            {
                                var parts = appUser.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                initials = parts.Length > 1 
                                    ? $"{parts[0][0]}{parts[^1][0]}".ToUpper() 
                                    : $"{parts[0][0]}".ToUpper();
                            }
                            else
                            {
                                initials = "NA";
                            }

                            <!-- Avatar & Dropdown V4 -->
                            <div class="dropdown">
                                <button class="btn dropdown-toggle d-flex align-items-center border-0 bg-transparent p-0 ms-2" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="outline:none;">
                                    <div class="d-flex align-items-center justify-content-center fw-bold" 
                                         style="width: 48px; height: 48px; border-radius: var(--cm-circle-radius); border: var(--cm-hand-border-thin); background-color: var(--cm-surface); box-shadow: var(--cm-shadow); font-family: var(--cm-font-hand); font-size: 20px;">
                                        @initials
                                    </div>
                                    <span class="ms-2 fw-semibold d-none d-lg-inline-block">@appUser?.FullName</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end mt-2" aria-labelledby="userMenuDropdown" 
                                    style="border: var(--cm-hand-border-thin); border-radius: var(--cm-radius); box-shadow: var(--cm-sticker); background-color: var(--cm-surface);">
                                    <li><a class="dropdown-item py-2 fw-semibold" asp-area="Client" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                                    <li><hr class="dropdown-divider" style="border-top-color: var(--cm-muted);"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item py-2 text-danger fw-semibold"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link fw-bold me-3 text-dark px-3"
                               asp-controller="Account" asp-action="Login"
                               style="border: 2px solid var(--cm-ink); border-radius: var(--cm-radius); background-color: var(--cm-surface);">
                                Đăng nhập
                            </a>
                            <a class="btn fw-bold"
                               asp-controller="Account" asp-action="Register" 
                               style="background-color: var(--cm-accent); color: var(--cm-ink); border: 2px solid var(--cm-ink); border-radius: var(--cm-radius); box-shadow: 4px 4px 0 var(--cm-ink); padding: 0.4rem 1.25rem; transition: transform 0.1s;">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bulb-footer">
        <div class="container bulb-footer-inner d-flex flex-column
                    align-items-center justify-content-center text-center">

            <p class="bulb-footer-wordmark">Bulb</p>

            <p class="bulb-footer-placeholder">
                <a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">Chính sách bảo mật</a>
                &bull;
                <a href="#" class="text-white text-decoration-none">Điều khoản sử dụng</a>
                <br />
                &copy; 2026 Bulb &mdash; Website SaaS Quản Lý Lớp Học Trực Tuyến
            </p>

            <!-- Gạch chân phác tay trang trí -->
            <svg class="bulb-footer-line"
                 viewBox="0 0 260 12"
                 aria-hidden="true"
                 focusable="false">
                <path d="M4 6 C60 3 100 8 145 5 S215 7 256 5" />
            </svg>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
