@* ============================================================
    File: Views/Shared/_Layout.cshtml (PUBLIC)
    Mô tả: Layout cho trang công khai
    CHECKPOINT: @inject SignInManager — hiển thị khác nhau khi login/chưa login
    SEO: <html lang="vi">, <meta description>, semantic tags
============================================================ *@
@using Microsoft.AspNetCore.Identity
@using WebHocTap_SaaS_.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClassManagement</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="author" content="ClassManagement Team" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark public-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🎓 ClassManagement
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#publicNavbar"
                        aria-controls="publicNavbar" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#features">Tính năng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Pricing">Bảng giá</a>
                        </li>
                    </ul>

                    @* --------------------------------------------------
                       CHECKPOINT: Hiển thị nút theo trạng thái đăng nhập
                       Chưa login → Đăng nhập / Đăng ký
                       Đã login → Xin chào FullName + form POST logout
                    -------------------------------------------------- *@
                    <div class="d-flex gap-2 align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var appUser = await UserManager.GetUserAsync(User);
                            <span class="text-light me-2">Xin chào, <strong>@appUser?.FullName</strong></span>
                            @* CHECKPOINT: Logout BẮT BUỘC form POST — chống CSRF *@
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-warning fw-semibold">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer text-center py-4 mt-5">
        <div class="container">
            <p class="mb-1">&copy; 2026 ClassManagement — Website SaaS Quản Lý Lớp Học Trực Tuyến</p>
            <p class="mb-0 text-muted small">
                <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Chính sách bảo mật</a>
                &bull;
                <a href="#" class="text-muted text-decoration-none">Điều khoản sử dụng</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
