@* ============================================================
    File: Views/Shared/_Layout.cshtml (PUBLIC)
    Mô tả: Layout cho trang công khai (khách chưa đăng nhập)
    CHECKPOINT: Navbar responsive (navbar-expand-lg + navbar-toggler)
    SEO: <html lang="vi">, <meta description>, semantic tags
    CHỈ reference Bootstrap từ ~/lib/bootstrap — KHÔNG thêm CDN
============================================================ *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClassManagement</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="author" content="ClassManagement Team" />
    @* CHECKPOINT: Chỉ dùng Bootstrap local — KHÔNG thêm CDN để tránh xung đột version *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @* --------------------------------------------------
       CHECKPOINT: Navbar PUBLIC — responsive với navbar-expand-lg
       Khi < 992px: thu gọn thành hamburger menu
       Khi ≥ 992px: hiển thị đầy đủ các link
    -------------------------------------------------- *@
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark public-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🎓 ClassManagement
                </a>

                @* Nút hamburger cho mobile *@
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#publicNavbar"
                        aria-controls="publicNavbar" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNavbar">
                    @* Menu trái *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#features">Tính năng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Pricing">Bảng giá</a>
                        </li>
                    </ul>

                    @* Nút bên phải *@
                    <div class="d-flex gap-2">
                        <a href="/Account/Login" class="btn btn-outline-light">Đăng nhập</a>
                        <a href="/Account/Register" class="btn btn-warning fw-semibold">Đăng ký</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @* --------------------------------------------------
       CHECKPOINT: Nội dung chính — semantic <main> tag
    -------------------------------------------------- *@
    <main>
        @RenderBody()
    </main>

    @* --------------------------------------------------
       CHECKPOINT: Footer — semantic <footer> tag
    -------------------------------------------------- *@
    <footer class="public-footer text-center py-4 mt-5">
        <div class="container">
            <p class="mb-1">&copy; 2026 ClassManagement — Website SaaS Quản Lý Lớp Học Trực Tuyến</p>
            <p class="mb-0 text-muted small">
                <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Chính sách bảo mật</a>
                &bull;
                <a href="#" class="text-muted text-decoration-none">Điều khoản sử dụng</a>
            </p>
        </div>
    </footer>

    @* CHECKPOINT: Script — chỉ dùng local, KHÔNG CDN *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
