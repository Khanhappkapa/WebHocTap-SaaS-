@* ============================================================
    File: Views/Account/AccessDenied.cshtml
    Mô tả: Trang thông báo không có quyền truy cập
============================================================ *@
@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-5">
                        <div class="display-1 mb-3">🚫</div>
                        <h1 class="h3 fw-bold mb-3">Truy cập bị từ chối</h1>
                        <p class="text-muted mb-4">
                            Bạn không có quyền truy cập trang này.
                            Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là nhầm lẫn.
                        </p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            🏠 Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
