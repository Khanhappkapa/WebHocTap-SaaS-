@* ============================================================
    File: Views/Account/AccessDenied.cshtml
    Mô tả: Trang thông báo không có quyền truy cập (V4)
============================================================ *@
@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<main class="on-public py-5">
    <div class="container pb-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">
                <div class="form-page form-card p-5 position-relative">
                    
                    <div class="mb-4 d-flex justify-content-center">
                        <img src="/images/Locked door ink scribble.svg" alt="Access Denied" style="width: 140px; height: auto;" aria-hidden="true" />
                    </div>

                    <h1 class="fw-bold mb-3" style="font-family: var(--cm-font-hand); font-size: 3rem; transform: rotate(-2deg); color: var(--cm-danger);">Bạn không có quyền truy cập</h1>
                    
                    <p class="mb-4 fw-semibold" style="font-size: 1.1rem; color: var(--cm-ink);">
                        Bạn không có quyền truy cập trang hoặc tài nguyên này. 
                        Nếu bạn cho rằng đây là sự nhầm lẫn, vui lòng liên hệ giáo viên quản lý lớp học.
                    </p>
                    
                    <a asp-controller="Home" asp-action="Index" class="btn btn-cta-ghost fw-bold py-2 px-4 fs-5">
                        <i class="bi bi-house-door me-2" aria-hidden="true"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
