@* ============================================================
    File: Views/Account/Login.cshtml
    Mô tả: Trang đăng nhập (V4)
============================================================ *@
@model WebHocTap_SaaS_.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập vào ClassManagement.";
}

<main class="on-public py-5">
    <div class="container pb-5">
        <div class="row align-items-center justify-content-center">
            <div class="col-md-8 col-lg-5">
                <div class="auth-card form-page position-relative p-4 p-md-5">
                    <p class="mb-1" style="font-family: var(--cm-font-hand); font-size: 1.5rem; color: var(--cm-muted);">Chào mừng trở lại!</p>
                    <h1 class="h2 text-center fw-bold mb-2">Đăng Nhập</h1>
                    <div class="text-center mb-4">
                        <svg viewBox="0 0 260 12" aria-hidden="true" style="width: 140px; height: auto; fill: none; stroke: var(--cm-primary); stroke-width: 2.5; stroke-linecap: round;"><use href="#bulb-detail-wave"></use></svg>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="error-msg mb-3" role="alert"></div>

                    <form asp-action="Login" method="post" novalidate>
                        @* Email *@
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control sketch-input" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="error-msg d-block mt-1"></span>
                        </div>

                        @* Mật khẩu *@
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" class="form-control sketch-input" placeholder="Nhập mật khẩu" />
                            <span asp-validation-for="Password" class="error-msg d-block mt-1"></span>
                        </div>

                        @* Ghi nhớ *@
                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input border-dark" />
                                <label asp-for="RememberMe" class="form-check-label fw-semibold"></label>
                            </div>
                            <a href="#" class="text-dark fw-bold text-decoration-none" style="font-family: var(--cm-font-hand); font-size: 1.2rem;">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-cta w-100 fw-bold py-3 fs-5">
                            <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i> Đăng nhập
                        </button>
                    </form>

                    <div class="mt-4 pt-3 text-center border-top border-dark" style="border-width: 1.5px !important;">
                        <p class="mb-0 fw-semibold text-dark">
                            Chưa có tài khoản?
                            <a asp-action="Register" class="text-dark fw-bold text-decoration-underline ms-1">Đăng ký</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
