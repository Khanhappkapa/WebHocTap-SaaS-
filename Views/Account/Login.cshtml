@* ============================================================
    File: Views/Account/Login.cshtml
    Mô tả: Trang đăng nhập
    CHECKPOINT: Bootstrap card căn giữa + asp-validation-for
============================================================ *@
@model WebHocTap_SaaS_.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập vào ClassManagement.";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="h3 text-center fw-bold mb-4"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</h1>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <form asp-action="Login" method="post">
                            @* Email *@
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            @* Mật khẩu *@
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            @* Ghi nhớ *@
                            <div class="mb-3 form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                                <i class="bi bi-key"></i> Đăng nhập
                            </button>
                        </form>

                        <hr />
                        <p class="text-center text-muted mb-0">
                            Chưa có tài khoản?
                            <a asp-action="Register" class="text-decoration-none fw-semibold">Đăng ký ngay</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
