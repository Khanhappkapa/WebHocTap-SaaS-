@* ============================================================
    File: Views/Account/Register.cshtml
    Mô tả: Trang đăng ký tài khoản
    CHECKPOINT: Bootstrap card căn giữa + asp-validation-for
    CHECKPOINT: Dropdown UserRole CHỈ có Teacher/Student (KHÔNG có Admin)
============================================================ *@
@model WebHocTap_SaaS_.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    ViewData["Description"] = "Đăng ký tài khoản ClassManagement — Nền tảng quản lý lớp học trực tuyến.";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h1 class="h3 text-center fw-bold mb-4">📝 Đăng ký tài khoản</h1>

                        @* CHECKPOINT: Hiển thị lỗi chung (vd: Identity errors) *@
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <form asp-action="Register" method="post">
                            @* Họ và tên *@
                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            @* Email *@
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            @* Mật khẩu *@
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự, có chữ số" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            @* Xác nhận mật khẩu *@
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            @* --------------------------------------------------
                               CHECKPOINT: Dropdown UserRole
                               CHỈ có 2 option: Teacher và Student
                               KHÔNG có option Admin → chống leo thang đặc quyền
                               Kể cả F12 sửa value → server chặn cứng trong AccountController
                            -------------------------------------------------- *@
                            <div class="mb-4">
                                <label asp-for="UserRole" class="form-label"></label>
                                <select asp-for="UserRole" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                    <option value="Teacher">👨‍🏫 Giáo viên (Teacher)</option>
                                    <option value="Student">👨‍🎓 Học viên (Student)</option>
                                </select>
                                <span asp-validation-for="UserRole" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
                                🚀 Đăng ký
                            </button>
                        </form>

                        <hr />
                        <p class="text-center text-muted mb-0">
                            Đã có tài khoản?
                            <a asp-action="Login" class="text-decoration-none fw-semibold">Đăng nhập</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
