@* ============================================================
    File: Views/Account/Register.cshtml
============================================================ *@
@model WebHocTap_SaaS_.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<main class="on-public py-5">
    <div class="container pb-5">
        <div class="row align-items-center justify-content-center">
            <div class="col-md-9 col-lg-6">
                <div class="auth-card form-page position-relative p-4 p-md-5">
                    <h1 class="h2 text-center fw-bold mb-2">Tạo tài khoản <i class="bi bi-rocket-takeoff text-danger" aria-hidden="true"></i></h1>
                    <div class="text-center mb-4">
                        <svg viewBox="0 0 260 12" aria-hidden="true" style="width: 140px; height: auto; fill: none; stroke: var(--cm-text); stroke-width: 2.5; stroke-linecap: round;"><use href="#bulb-detail-wave"></use></svg>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="error-msg mb-3" role="alert"></div>

                    <form asp-action="Register" method="post" novalidate>
                        @* Họ và tên *@
                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control sketch-input" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="error-msg d-block mt-1"></span>
                        </div>

                        @* Email *@
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control sketch-input" placeholder="email@example.com" />
                            <span asp-validation-for="Email" class="error-msg d-block mt-1"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Password" class="form-label fw-bold"></label>
                                <input asp-for="Password" class="form-control sketch-input" placeholder="Tối thiểu 6 ký tự" />
                                <span asp-validation-for="Password" class="error-msg d-block mt-1"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                                <input asp-for="ConfirmPassword" class="form-control sketch-input" placeholder="Nhập lại mật khẩu" />
                                <span asp-validation-for="ConfirmPassword" class="error-msg d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UserRole" class="form-label fw-bold">Bạn là:</label>
                            <select asp-for="UserRole" class="form-select form-control sketch-input">
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Teacher">👨‍🏫 Giáo viên</option>
                                <option value="Student">🎓 Học viên</option>
                            </select>
                            <span asp-validation-for="UserRole" class="error-msg d-block mt-1"></span>
                        </div>

                        <button type="submit" class="btn btn-cta w-100 fw-bold py-3 fs-5">
                            <i class="bi bi-person-plus-fill me-2" aria-hidden="true"></i> Bắt đầu ngay
                        </button>
                    </form>

                    <div class="mt-4 pt-3 text-center border-top border-dark" style="border-width: 1.5px !important;">
                        <p class="mb-0 fw-semibold text-dark">
                            Đã có tài khoản?
                            <a asp-action="Login" class="text-dark fw-bold text-decoration-underline ms-1">Đăng nhập <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
