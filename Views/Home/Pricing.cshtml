@* ============================================================
    File: Views/Home/Pricing.cshtml
    Mô tả: Trang bảng giá SaaS (V4)
============================================================ *@
@{
    ViewData["Title"] = "Bảng giá";
    ViewData["Description"] = "So sánh các gói dịch vụ ClassManagement — Free, Pro và Enterprise.";
}

<main class="on-public py-5">
    <div class="container pb-5">
        <div class="text-center mb-5 position-relative">
            <h1 class="fw-bold" style="font-size: 2.5rem;">Chọn gói học phù hợp với hành trình của bạn</h1>
            <svg class="bulb-detail-wave mx-auto" viewBox="0 0 260 12" aria-hidden="true" style="fill:none; stroke:var(--cm-primary); stroke-width:3px; max-width: 260px;">
                <use href="#bulb-detail-wave"></use>
            </svg>
            <p class="mt-3 fw-semibold">Đơn giản, minh bạch và đầy đủ tính năng cho giáo viên & học sinh.</p>
        </div>

        <div class="row g-4 justify-content-center align-items-center">
            @* MẦM NON (FREE) *@
            <div class="col-lg-4 col-md-6">
                <div class="form-page p-4 text-center h-100 d-flex flex-column" style="border: var(--cm-hand-border); border-radius: var(--cm-hand-radius); background: var(--cm-surface); box-shadow: 4px 4px 0 var(--cm-ink);">
                    <h2 class="h3 fw-bold mb-3" style="font-family: var(--cm-font-hand); color: var(--cm-muted); transform: rotate(-2deg);"><i class="bi bi-sprout" aria-hidden="true"></i> Mầm Non</h2>
                    
                    <div class="mb-4">
                        <span class="d-block fw-bold" style="font-family: var(--cm-font-hand); font-size: 4rem; line-height: 1; color: var(--cm-ink);">Miễn phí</span>
                        <span class="text-muted fw-semibold">Mãi mãi</span>
                    </div>

                    <ul class="list-unstyled text-start mb-4 flex-grow-1 fw-semibold ms-3" style="font-size: 1.1rem; line-height: 1.8;">
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>2 Khóa học tối đa</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>30 Học sinh / khóa</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Bài tập & điểm số (Cơ bản)</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Lưu trữ 100MB</li>
                    </ul>

                    <a asp-controller="Account" asp-action="Register" class="btn btn-cta-ghost fw-bold py-2 fs-5">Bắt đầu ngay</a>
                </div>
            </div>

            @* NGÔI SAO (PRO) *@
            <div class="col-lg-4 col-md-6 position-relative z-3">
                <!-- Ribbon SVG & CSS can be placed relative to this wrapper -->
                <div class="position-absolute ribbon-pop align-items-center justify-content-center d-flex" style="top: -20px; right: -15px; width: 100px; height: 100px; border: var(--cm-hand-border); border-radius: 50%; z-index: 10; box-shadow: 2px 2px 0 var(--cm-ink);">
                    <span class="text-center fw-bold lh-sm text-dark" style="font-size: 1.25rem;">Phổ biến<br>nhất!</span>
                </div>

                <div class="form-page p-4 text-center h-100 d-flex flex-column border-dark" style="border: 3px solid var(--cm-ink); border-radius: var(--cm-radius); background: var(--cm-postit); box-shadow: 8px 8px 0 var(--cm-ink); transform: scale(1.05);">
                    <h2 class="h3 fw-bold mb-3" style="font-family: var(--cm-font-hand); color: var(--cm-primary); transform: rotate(-2deg);"><i class="bi bi-star-fill text-warning" aria-hidden="true"></i> Bứt Phá (Pro)</h2>
                    
                    <div class="mb-4">
                        <span class="d-block fw-bold" style="font-family: var(--cm-font-hand); font-size: 4rem; line-height: 1; color: var(--cm-primary);">299.000<span style="font-size: 2rem;">đ</span></span>
                        <span class="text-muted fw-semibold">/ tháng</span>
                    </div>

                    <ul class="list-unstyled text-start mb-4 flex-grow-1 fw-semibold ms-3" style="font-size: 1.1rem; line-height: 1.8;">
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Không giới hạn khóa học</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>500 Học sinh / khóa</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Hệ thống bài tập đầy đủ</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Lớp học Video Meeting</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Lưu trữ 20GB</li>
                    </ul>

                    <a asp-controller="Account" asp-action="Register" class="btn btn-cta fw-bold py-3 fs-5">Dùng thử 14 ngày</a>
                </div>
            </div>

            @* VÔ CỰC (ENTERPRISE) *@
            <div class="col-lg-4 col-md-6">
                <div class="form-page p-4 text-center h-100 d-flex flex-column" style="border: var(--cm-hand-border); border-radius: var(--cm-hand-radius-md); background: var(--cm-paper); box-shadow: 4px 4px 0 var(--cm-ink);">
                    <h2 class="h3 fw-bold mb-3" style="font-family: var(--cm-font-hand); color: var(--cm-ink); transform: rotate(1deg);"><i class="bi bi-building"></i> Tổ Chức</h2>
                    
                    <div class="mb-4">
                        <span class="d-block fw-bold" style="font-family: var(--cm-font-hand); font-size: 4rem; line-height: 1; color: var(--cm-ink);">Liên hệ</span>
                        <span class="text-muted fw-semibold">Báo giá theo quy mô</span>
                    </div>

                    <ul class="list-unstyled text-start mb-4 flex-grow-1 fw-semibold ms-3" style="font-size: 1.1rem; line-height: 1.8;">
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Mọi tính năng của Gói Pro</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Thương hiệu riêng (White-label)</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Thống kê tổng quan nâng cao</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Tích hợp API hệ thống ngoài</li>
                        <li><i class="bi bi-check-lg text-success fs-4 align-middle me-2"></i>Hỗ trợ ưu tiên 24/7</li>
                    </ul>

                    <a href="mailto:support@bulb.edu" class="btn btn-ink fw-bold py-2 fs-5">Nhận tư vấn</a>
                </div>
            </div>
        </div>
    </div>
</main>
