@* ============================================================
    File: Views/Home/Pricing.cshtml
    Mô tả: Trang bảng giá SaaS — 3 gói: Free / Pro / Enterprise
    CHECKPOINT: Responsive row + col-lg-4
    SEO: ViewData["Title"], ViewData["Description"], h1 → h2
============================================================ *@
@{
    ViewData["Title"] = "Bảng giá";
    ViewData["Description"] = "So sánh các gói dịch vụ ClassManagement — Free, Pro và Enterprise. Chọn gói phù hợp với nhu cầu giảng dạy trực tuyến của bạn.";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold">Bảng giá dịch vụ</h1>
            <p class="lead text-muted">Chọn gói phù hợp với nhu cầu của bạn</p>
        </div>

        <div class="row g-4 justify-content-center">
            @* --------------------------------------------------
               CHECKPOINT: Gói Free
            -------------------------------------------------- *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm pricing-card">
                    <div class="card-header text-center py-3 bg-light">
                        <h2 class="h4 fw-bold mb-0"><i class="bi bi-gift"></i> Free</h2>
                    </div>
                    <div class="card-body text-center p-4">
                        <div class="display-4 fw-bold text-primary mb-2">0đ</div>
                        <p class="text-muted mb-4">/tháng</p>
                        <ul class="list-unstyled text-start mb-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Tối đa 2 khóa học</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> 30 học sinh / khóa</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Giao bài tập cơ bản</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Tải tài liệu (100MB)</li>
                            <li class="mb-2 text-muted"><i class="bi bi-x-circle text-muted"></i> Lên lịch buổi học</li>
                            <li class="mb-2 text-muted"><i class="bi bi-x-circle text-muted"></i> Thống kê nâng cao</li>
                        </ul>
                        <a href="/Account/Register" class="btn btn-outline-primary w-100">
                            Bắt đầu miễn phí
                        </a>
                    </div>
                </div>
            </div>

            @* --------------------------------------------------
               CHECKPOINT: Gói Pro — phổ biến nhất, có badge
            -------------------------------------------------- *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-primary border-2 shadow pricing-card pricing-featured">
                    <div class="card-header text-center py-3 bg-primary text-white position-relative">
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">
                            <i class="bi bi-fire"></i> Phổ biến
                        </span>
                        <h2 class="h4 fw-bold mb-0"><i class="bi bi-star-fill"></i> Pro</h2>
                    </div>
                    <div class="card-body text-center p-4">
                        <div class="display-4 fw-bold text-primary mb-2">199K</div>
                        <p class="text-muted mb-4">/tháng</p>
                        <ul class="list-unstyled text-start mb-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Không giới hạn khóa học</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> 200 học sinh / khóa</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Giao bài & chấm điểm</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Tải tài liệu (5GB)</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Lên lịch buổi học</li>
                            <li class="mb-2 text-muted"><i class="bi bi-x-circle text-muted"></i> Thống kê nâng cao</li>
                        </ul>
                        <a href="/Account/Register" class="btn btn-primary w-100 fw-semibold">
                            Dùng thử 14 ngày
                        </a>
                    </div>
                </div>
            </div>

            @* --------------------------------------------------
               CHECKPOINT: Gói Enterprise
            -------------------------------------------------- *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm pricing-card">
                    <div class="card-header text-center py-3 bg-dark text-white">
                        <h2 class="h4 fw-bold mb-0"><i class="bi bi-building"></i> Enterprise</h2>
                    </div>
                    <div class="card-body text-center p-4">
                        <div class="display-4 fw-bold text-primary mb-2">499K</div>
                        <p class="text-muted mb-4">/tháng</p>
                        <ul class="list-unstyled text-start mb-4">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Mọi tính năng Pro</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Không giới hạn học sinh</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Tải tài liệu (50GB)</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Thống kê nâng cao</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Hỗ trợ ưu tiên 24/7</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success"></i> Logo riêng (White-label)</li>
                        </ul>
                        <a href="#" class="btn btn-dark w-100">
                            Liên hệ tư vấn
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
