@* ============================================================
    File: Views/Home/Index.cshtml
    Mô tả: Landing page — trang chủ công khai
    CHECKPOINT: Hero section + 3 card tính năng
    SEO: ViewData["Title"], ViewData["Description"], h1 → h2
============================================================ *@
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["Description"] = "ClassManagement — Nền tảng SaaS quản lý lớp học trực tuyến hàng đầu. Tạo khóa học, quản lý học sinh, giao bài tập và chấm điểm dễ dàng.";
}

@* --------------------------------------------------
   CHECKPOINT: Hero Section — giới thiệu SaaS
   Gradient nền + CTA buttons
-------------------------------------------------- *@
<section class="hero-section text-white text-center d-flex align-items-center">
    <div class="container py-5">
        <h1 class="display-4 fw-bold mb-3">
            Quản lý lớp học trực tuyến<br />thông minh & hiệu quả
        </h1>
        <p class="lead mb-4 mx-auto" style="max-width: 600px;">
            ClassManagement giúp giáo viên tạo khóa học, quản lý học sinh,
            giao bài tập và chấm điểm — tất cả trên một nền tảng duy nhất.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Account/Register" class="btn btn-warning btn-lg fw-semibold px-4">
                🚀 Bắt đầu miễn phí
            </a>
            <a asp-controller="Home" asp-action="Pricing" class="btn btn-outline-light btn-lg px-4">
                💰 Xem bảng giá
            </a>
        </div>
    </div>
</section>

@* --------------------------------------------------
   CHECKPOINT: 3 Card tính năng chính
   Responsive: col-lg-4 (3 cột desktop) → col-md-6 → col-12 (mobile)
   SEO: h2 cho section title, h3 cho card title
-------------------------------------------------- *@
<section class="py-5 bg-light" id="features">
    <div class="container">
        <h2 class="text-center fw-bold mb-2">Tính năng nổi bật</h2>
        <p class="text-center text-muted mb-5">Mọi thứ bạn cần để quản lý lớp học hiệu quả</p>

        <div class="row g-4">
            @* Card 1: Quản lý khóa học *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm feature-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">📚</div>
                        <h3 class="h5 fw-bold">Quản lý khóa học</h3>
                        <p class="text-muted">
                            Tạo và quản lý khóa học dễ dàng. Đăng tải tài liệu,
                            lên lịch buổi học trực tuyến chỉ với vài cú click.
                        </p>
                    </div>
                </div>
            </div>

            @* Card 2: Giao & chấm bài tập *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm feature-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">📝</div>
                        <h3 class="h5 fw-bold">Giao & chấm bài tập</h3>
                        <p class="text-muted">
                            Tạo bài tập với deadline, nhận bài nộp từ học sinh,
                            chấm điểm và gửi nhận xét trực tiếp trên hệ thống.
                        </p>
                    </div>
                </div>
            </div>

            @* Card 3: Học trực tuyến *@
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm feature-card">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon mb-3">🎥</div>
                        <h3 class="h5 fw-bold">Học trực tuyến</h3>
                        <p class="text-muted">
                            Tích hợp link họp (Zoom, Google Meet) cho buổi học.
                            Quản lý lịch học và theo dõi tiến độ học sinh.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
